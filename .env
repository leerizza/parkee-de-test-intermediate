# Postgres (OLTP source, 3 tenant schemas)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port mapping (container always listens on 5432 internally);
# change if 5434 is also taken on your machine.
POSTGRES_HOST_PORT=5434
POSTGRES_DB=parkee
POSTGRES_USER=parkee
POSTGRES_PASSWORD=parkee_secret

# ClickHouse (Data Warehouse)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=raw
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
# Host-side port mapping (container always listens on 8123/9000 internally);
# change if these are also taken on your machine (e.g. another local service).
CLICKHOUSE_HTTP_HOST_PORT=8124
CLICKHOUSE_NATIVE_HOST_PORT=9000

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=parkee_airflow_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# FastAPI
API_PORT=8000

# Dashboard
DASHBOARD_PORT=8080
